ometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;EC2 gestionpyme-web · t3.micro&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Ubuntu 24.04 · 10 GiB gp3 · Docker + Compose (user-data.sh)&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;dashed=0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="700" height="450" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;nginx:1.27-alpine&lt;/font&gt;&lt;br&gt;publica 80 → 80&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;redes: publica + aplicacion&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="460" width="270" height="95" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;gestionpyme-api:1.0 (Node.js 24)&lt;/font&gt;&lt;br&gt;3000 SIN publicar&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;redes: aplicacion + datos&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="600" width="270" height="95" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;db&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;postgres:17-alpine&lt;/font&gt;&lt;br&gt;5432 SIN publicar&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;red: datos · volumen: datos&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#16425b;strokeColor=#0f2f40;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="730" width="270" height="105" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Redes de Docker Compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;publica (normal)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;solo el proxy · puede salir&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;aplicacion (internal: true)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;proxy ↔ api · sin salida a internet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;datos (internal: true)&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;api ↔ db · sin salida a internet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;b&gt;Volumen persistente: datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;las facturas sobreviven si se cae&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;o se reinicia el contenedor db&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;b&gt;Configuración: .env&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;DB_PASSWORD y PUERTO_WEB=80&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(nunca en el repositorio)&lt;/font&gt;" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="460" width="340" height="375" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Subred privada · 10.0.128.0/20&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;us-east-2a · solo ruta local&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;h