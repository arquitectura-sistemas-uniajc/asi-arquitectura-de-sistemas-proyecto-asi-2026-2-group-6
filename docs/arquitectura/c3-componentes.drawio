="235" width="210" height="90" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;GET /metrics" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="235" width="210" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Productos e inventario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Módulo]&lt;/font&gt;&lt;br&gt;GET /api/items&lt;br&gt;GET /api/resumen" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="280" height="110" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Facturación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Módulo]&lt;/font&gt;&lt;br&gt;POST y GET /api/registros&lt;br&gt;Factura + descuento de inventario&lt;br&gt;en una transacción" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="300" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Reportes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Módulo]&lt;/font&gt;&lt;br&gt;Encola el reporte mensual&lt;br&gt;y responde 202 (ADR-0002)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="260" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Acce