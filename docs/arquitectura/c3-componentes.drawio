<mxfile host="drawio" type="device"><diagram id="c3-componentes" name="c3-componentes"><mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;GestiónPyme · C4 Nivel 3: Componentes de la API&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="15" width="1500" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Zoom dentro del contenedor API GestiónPyme (Node.js 24 + Express). Borde punteado = planeado.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="1500" height="20" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Portal web y proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Nginx 1.27]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="320" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Prometheus]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="240" height="70" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strok