<mxfile host="drawio" type="device"><diagram id="c2-contenedores" name="c2-contenedores"><mxGraphModel dx="1320" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;GestiónPyme · C4 Nivel 2: Contenedores&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="15" width="1320" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Cada caja dice su tecnología y cada flecha qué viaja y por qué protocolo. Borde punteado = planeado.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="1320" height="20" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Vendedor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Contador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Persona]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Sistema GestiónPyme&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1168bd;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="930" height="750" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Tablero&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Grafana]&lt;/font&gt;&lt;br&gt;4 paneles: req/s, p95,&lt;br&gt;errores, CPU y memoria" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="280" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Portal web y proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Nginx 1.27 + HTML/CSS/JS]&lt;/font&gt;&lt;br&gt;Sirve la página y reparte /api/&lt;br&gt;entre las réplicas de la API&lt;br&gt;con verificación de salud" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="305" width="340" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Prometheus]&lt;/font&gt;&lt;br&gt;Recolecta métricas cada 15 s&lt;br&gt;y dispara alertas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="500" width="280" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;API GestiónPyme&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Node.js 24 + Express]&lt;/font&gt;&lt;br&gt;Monolito modular: productos e&lt;br&gt;inventario, facturación,&lt;br&gt;auditoría y reportes&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;2 réplicas (hoy corre 1)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="340" height="130" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Caché y cola&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Redis 7]&lt;/font&gt;&lt;br&gt;Caché de /api/resumen y&lt;br&gt;cola del reporte mensual" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="730" width="280" height="100" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: PostgreSQL 17]&lt;/font&gt;&lt;br&gt;Productos, facturas&lt;br&gt;y auditoría" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#16425b;strokeColor=#0f2f40;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="590" y="730" width="280" height="130" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Worker de reportes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Contenedor: Node.js 24]&lt;/font&gt;&lt;br&gt;Genera el reporte mensual" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="895" width="300" height="90" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Servicio de correo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Sistema externo · opcional]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="520" width="250" height="90" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;[Sistema externo · AWS]&lt;/font&gt;&lt;br&gt;Respaldos y WAL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="750" width="250" height="90" as="geometry"/></mxCell><mxCell id="n17" value="Usa la aplicación&lt;br&gt;[HTTP :80 · HTTPS en producción]" style="html=1;endArrow=classic;endFill=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="n4" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="Factura&lt;br&gt;[HTTP :80 · HTTPS]" style="html=1;endArrow=classic;endFill=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="Consulta y pide reportes&lt;br&gt;[HTTP :80 · HTTPS]" style="html=1;endArrow=classic;endFill=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;