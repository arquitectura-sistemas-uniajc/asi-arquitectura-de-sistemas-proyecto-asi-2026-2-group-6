// C4 nivel 2 (contenedores) de GestionPyme. Generar: dot -Tpng c4-nivel-2-contenedores.dot -o ../diagrama-contenedores-nivel-2.png
digraph C4_L2 {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, nodesep=0.7, ranksep=0.75, pad=0.4, bgcolor="white",
         label=<<B>GestiónPyme · C4 Nivel 2: Contenedores</B><BR/><FONT POINT-SIZE="11">Cada caja dice su tecnología y cada flecha qué viaja y por qué protocolo.<BR/>Borde punteado = planeado (aún no implementado)</FONT>>,
         labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.1", penwidth=1.4];
  edge [fontname="DejaVu Sans", fontsize=9.5, color="#334155", fontcolor="#1e293b", penwidth=1.2];

  admin    [label=<<B>Administrador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/>Gestiona productos<BR/>e inventario>, fillcolor="#1e3a5f", fontcolor="white", color="#1e3a5f"];
  vendedor [label=<<B>Vendedor</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/>Registra ventas<BR/>y emite facturas>, fillcolor="#1e3a5f", fontcolor="white", color="#1e3a5f"];
  contador [label=<<B>Contador</B><BR/><FONT POINT-SIZE="9">[Persona]</FONT><BR/>Consulta y pide el<BR/>reporte mensual>, fillcolor="#1e3a5f", fontcolor="white", color="#1e3a5f"];

  subgraph cluster_sys {
    label=<<B>Sistema GestiónPyme</B>>; style="dashed,rounded"; color="#3d5a80"; fontsize=13; margin=18;
    proxy  [label=<<B>Proxy y portal web</B><BR/><FONT POINT-SIZE="9">[Contenedor: Nginx 1.27]</FONT><BR/>Sirve HTML/CSS/JS y balancea<BR/>/api/ entre las réplicas con<BR/>verificación de salud. Único<BR/>puerto publicado (80)>, fillcolor="#2f6690", fontcolor="white", color="#2f6690"];
    api    [label=<<B>API GestiónPyme</B><BR/><FONT POINT-SIZE="9">[Contenedor: Node.js 24 + Express]</FONT><BR/>Monolito modular: productos e<BR/>inventario, facturación,<BR/>auditoría, reportes.<BR/>2 réplicas (hoy corre 1)>, fillcolor="#2f6690", fontcolor="white", color="#2f6690"];
    db     [label=<<B>Base de datos</B><BR/><FONT POINT-SIZE="9">[Contenedor: PostgreSQL 17]</FONT><BR/>Productos, facturas,<BR/>auditoría. Volumen<BR/>persistente "datos">, shape=cylinder, fillcolor="#16425b", fontcolor="white", color="#16425b"];
    redis  [label=<<B>Caché y cola</B><BR/><FONT POINT-SIZE="9">[Contenedor: Redis 7]</FONT><BR/>Caché de /api/resumen y<BR/>cola del reporte mensual>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    worker [label=<<B>Worker de reportes</B><BR/><FONT POINT-SIZE="9">[Contenedor: Node.js 24]</FONT><BR/>Mismo código que la API,<BR/>otro punto de entrada.<BR/>Genera el reporte mensual>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    prom [label=<<B>Métricas</B><BR/><FONT POINT-SIZE="9">[Contenedor: Prometheus]</FONT><BR/>Recolecta métricas cada 15 s<BR/>y dispara alertas>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    graf [label=<<B>Tablero</B><BR/><FONT POINT-SIZE="9">[Contenedor: Grafana]</FONT><BR/>4 paneles: req/s, p95,<BR/>errores, CPU/memoria>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    { rank=same; db; redis; }
  }

  { rank=min; admin; vendedor; contador; }
  s3 [label=<<B>Amazon S3</B><BR/><FONT POINT-SIZE="9">[Sistema externo]</FONT><BR/>Respaldo base y WAL>, fillcolor="#f1f5f9", fontcolor="#334155", color="#94a3b8", style="rounded,filled,dashed"];

  admin    -> proxy [label="HTTP :80\n(HTTPS en producción)"];
  vendedor -> proxy [label="HTTP :80\n(HTTPS en producción)"];
  contador -> proxy [label="HTTP :80\n(HTTPS en producción)"];
  proxy -> api    [label="HTTP/JSON :3000\nred interna \"aplicacion\""];
  api   -> db     [label="SQL · TCP 5432\nred interna \"datos\""];
  api   -> redis  [label="caché y encola trabajo\nRESP · TCP 6379", style=dashed];
  redis -> worker [label="entrega trabajo\nRESP · TCP 6379", style=dashed];
  worker -> db    [label="consulta del mes\nSQL · TCP 5432", style=dashed];
  prom -> api    [label="lee /metrics\nHTTP :3000", style=dashed];
  graf -> prom   [label="consultas PromQL\nHTTP :9090", style=dashed];
  db -> s3        [label="WAL + respaldo diario\nHTTPS :443 (ADR-003)", style=dashed];
}
