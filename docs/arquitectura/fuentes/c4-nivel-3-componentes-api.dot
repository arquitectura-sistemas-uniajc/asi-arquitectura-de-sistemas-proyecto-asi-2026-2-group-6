// C4 nivel 3 (componentes de la API). Generar: dot -Tpng c4-nivel-3-componentes-api.dot -o ../diagrama-componentes-nivel-3.png
digraph C4_L3 {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.7, pad=0.4, bgcolor="white", fontsize=18, labelloc=t,
         label=<<B>GestiónPyme · C4 Nivel 3: Componentes de la API</B><BR/><FONT POINT-SIZE="11">Zoom dentro del contenedor "API GestiónPyme" (Node.js 24 + Express). Borde punteado = planeado.</FONT>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10.5, margin="0.16,0.08", penwidth=1.3];
  edge [fontname="DejaVu Sans", fontsize=9, color="#334155", fontcolor="#1e293b"];

  proxy [label=<<B>Proxy y portal web</B><BR/><FONT POINT-SIZE="9">[Contenedor: Nginx 1.27]</FONT>>, fillcolor="#94a3b8", fontcolor="white", color="#64748b"];

  subgraph cluster_api {
    label=<<B>API GestiónPyme</B>  [Contenedor: Node.js 24 + Express]>; style="dashed,rounded"; color="#2f6690"; fontsize=12; margin=16;

    rutas [label=<<B>Enrutador HTTP</B><BR/><FONT POINT-SIZE="9">[Componente: Express Router · index.js]</FONT><BR/>Recibe /api/*, valida entrada<BR/>y llama al módulo que corresponde>, fillcolor="#3a7ca5", fontcolor="white", color="#3a7ca5"];
    salud [label=<<B>Salud</B><BR/><FONT POINT-SIZE="9">[Componente]</FONT><BR/>GET /health y /api/health<BR/>(Docker, Nginx y monitoreo)>, fillcolor="#3a7ca5", fontcolor="white", color="#3a7ca5"];

    productos [label=<<B>Productos e inventario</B><BR/><FONT POINT-SIZE="9">[Módulo]</FONT><BR/>GET /api/items, GET /api/resumen<BR/>Catálogo y existencias>, fillcolor="#2f6690", fontcolor="white", color="#2f6690"];
    facturacion [label=<<B>Facturación</B><BR/><FONT POINT-SIZE="9">[Módulo]</FONT><BR/>POST y GET /api/registros<BR/>Factura + descuento de inventario<BR/>en UNA transacción (BEGIN…COMMIT)>, fillcolor="#2f6690", fontcolor="white", color="#2f6690"];
    auditoria [label=<<B>Auditoría</B><BR/><FONT POINT-SIZE="9">[Módulo]</FONT><BR/>Anular factura con<BR/>registro de auditoría>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    reportes [label=<<B>Reportes</B><BR/><FONT POINT-SIZE="9">[Módulo]</FONT><BR/>Encola el reporte mensual<BR/>y responde 202 (ADR-002)>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];

    metricas [label=<<B>Métricas</B><BR/><FONT POINT-SIZE="9">[Componente]</FONT><BR/>GET /metrics: req/s,<BR/>latencia y errores>, fillcolor="#e2e8f0", fontcolor="#0f172a", color="#475569", style="rounded,filled,dashed"];
    datos [label=<<B>Acceso a datos</B><BR/><FONT POINT-SIZE="9">[Componente: pg Pool · db.js]</FONT><BR/>Pool de conexiones a PostgreSQL<BR/>(DATABASE_URL desde .env)>, fillcolor="#16425b", fontcolor="white", color="#16425b"];
    dominio [label=<<B>Configuración del dominio</B><BR/><FONT POINT-SIZE="9">[Componente: dominio.json]</FONT><BR/>Textos y reglas de GestiónPyme>, fillcolor="#3a7ca5", fontcolor="white", color="#3a7ca5"];

    { rank=same; productos; facturacion; auditoria; reportes; }
  }

  db    [label=<<B>Base de datos</B><BR/><FONT POINT-SIZE="9">[Contenedor: PostgreSQL 17]</FONT>>, shape=cylinder, fillcolor="#94a3b8", fontcolor="white", color="#64748b"];
  redis [label=<<B>Caché y cola</B><BR/><FONT POINT-SIZE="9">[Contenedor: Redis 7]</FONT>>, fillcolor="#f1f5f9", fontcolor="#334155", color="#94a3b8", style="rounded,filled,dashed"];

  proxy -> rutas [label="HTTP/JSON :3000"];
  proxy -> salud [label="GET /api/health"];
  rutas -> productos; rutas -> facturacion;
  rutas -> reportes [style=dashed]; rutas -> dominio [label="GET /api/info"];
  facturacion -> auditoria [style=dashed, label="anulación"];
  productos -> datos; facturacion -> datos; auditoria -> datos [style=dashed]; salud -> datos [label="SELECT 1"];
  datos -> db [label="SQL · TCP 5432"];
  prom [label=<<B>Métricas</B><BR/><FONT POINT-SIZE="9">[Contenedor: Prometheus]</FONT>>, fillcolor="#f1f5f9", fontcolor="#334155", color="#94a3b8", style="rounded,filled,dashed"];
  prom -> metricas [label="HTTP :3000", style=dashed];
  reportes -> redis [label="RESP · TCP 6379", style=dashed];
}
