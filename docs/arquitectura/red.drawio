<mxfile host="drawio" type="device"><diagram id="red" name="red"><mxGraphModel dx="1300" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;GestiónPyme · Plan de red&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="15" width="1300" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Una subred es pública por su ruta 0.0.0.0/0 → Internet Gateway, no por su nombre&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="0" y="45" width="1300" height="20" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Internet&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="75" width="300" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;VPC gestionpyme-vpc · 10.0.0.0/16 · us-east-2 (Ohio)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16425b;dashed=0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1220" height="815" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;gestionpyme-igw&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#b45309;fontColor=#78350f;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="205" width="200" height="55" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Subred pública&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;10.0.0.0/20 · us-east-2a&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;dashed=0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="580" height="670" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;EC2 gestionpyme-web (IP privada 10.0.x.x + IP pública)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;proxy · puerto 80 publicado&lt;br&gt;api · 3000 sin publicar (red Docker interna)&lt;br&gt;db · 5432 sin publicar (red Docker interna)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="410" width="520" height="160" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Grupo de seguridad gestionpyme-web-sg (entrada)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;HTTP 80/TCP desde 0.0.0.0/0 · los usuarios usan la app&lt;br&gt;SSH 22/TCP desde IP admin /32 · administrar&lt;br&gt;3000 y 5432 · sin regla = bloqueados&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Salida: todo (instalar Docker y descargar imágenes)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="520" height="160" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Tabla de rutas gestionpyme-rtb-public&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;10.0.0.0/16 → local&lt;br&gt;0.0.0.0/0 → gestionpyme-igw  ← la hace pública" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="790" width="520" height="150" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Subred privada&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;10.0.128.0/20 · us-east-2a&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;dashed=0;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="550" height="670" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Vacía hoy&lt;/b&gt;&lt;br&gt;Reservada para la base de datos (RDS)&lt;br&gt;si crece el presupuesto (ADR-0004)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;dashed=1;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="410" width="490" height="160" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Tabla de rutas gestionpyme-rtb-private1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;10.0.0.0/16 → local&lt;br&gt;(sin 0.0.0.0/0: no tiene camino a internet)" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="790" width="490" height="150" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Lo que NO tiene camino desde internet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;API (3000): sin regla en el SG y sin publicar&lt;br&gt;Base (5432): sin regla en el SG y sin publicar&lt;br&gt;Subred privada: sin ruta al Internet Gateway&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; &lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Dos barreras: si falla una, la otra sigue&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;dashed=0;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="600" width="490" height="160" as="geometry"/></mxCell><mxCell id="n15" value="HTTP 80 · SSH 22" style="html=1;endArrow=classic;endFill=1;strokeColor=#334155;strokeWidth=1.5;dashed=0;fontSize=10;fontColor=#1e293b;labelBackgroundColor=#ffffff;rounded=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="80 ✓ · 22 ✓ (IP admin)" style="html=1;endArrow=classic;endFill=1;strokeColor=#15803d;strokeWidth=2;dashed=0;fontSize=10;fontColor=#15803d;labelBackgroundColor=#ffffff;rounded=0;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="3000 ✗ · 5432 ✗" style="html=1;endArrow=baseDash;endFill=1;strokeColor=#dc2626;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#dc2626;labelBackgroundColor=#ffffff;rounded=0;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="✗ sin ruta" style="html=1;endArrow=baseDash;endFill=1;strokeColor=#dc2626;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#dc2626;labelBackgroundColor=#ffffff;rounded=0;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" tar